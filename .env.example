# Estate Organiser – configuration template
#
# Copy this file to the location the container reads at startup (see the
# deployment guide), fill in the real values there, and keep that copy out of
# Git. This template is safe to commit; the real file is not.
#
# On Unraid the file lives alongside the data, for example:
#   /mnt/user/appdata/<app>/estate.env
# The container reads it at startup and passes the values to the app.

# --- Identity: Cloudflare Access (required in production) ---
# Your Zero Trust team domain, including https://, for example
# https://your-team.cloudflareaccess.com
CF_ACCESS_ISSUER=
# The Application Audience (AUD) tag of the Access application protecting this app.
# Find it in Cloudflare Zero Trust: Access > Applications > your app > Overview.
CF_ACCESS_AUDIENCE=
# Exactly two Google email addresses, comma separated.
# This is the server-side allowlist: anything else is rejected, and the value
# must never be supplied by the browser.
AUTH_USER_EMAILS=

# --- Storage (paths as seen inside the container) ---
# SQLite database file. On Unraid this is mapped to the appdata folder, for
# example /mnt/user/appdata/<app>/estate.sqlite
DATABASE_PATH=/data/estate.sqlite
# Uploaded documents (PDFs, scans, screenshots). On Unraid this is mapped to
# the appdata folder, for example /mnt/user/appdata/<app>/documents
DOCUMENTS_PATH=/data/documents

# --- Development only: never enable for a real installation ---
# When true in development, the app ignores DATABASE_PATH and DOCUMENTS_PATH and
# always uses ./data/demo.sqlite and ./data/demo-documents, so fictional records
# can never mix with real ones. It has no effect in production.
DEV_AUTH_ENABLED=false
# Only used by the development preview if you want a different demo folder.
# DEMO_DOCUMENTS_PATH=./data/demo-documents
