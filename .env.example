# Estate Organiser – production configuration template
#
# Copy this file to /mnt/user/appdata/estate-organiser/estate.env on Unraid,
# then fill in the real values there. The container loads that file at startup.
# This template is safe to commit; the filled-in file is private and must stay
# outside Git, chat, and Docker image build contexts.

# --- Identity: Cloudflare Access (required in production) ---
# Your Zero Trust team domain, including https://.
CF_ACCESS_ISSUER=
# The Access application's AUD tag, shown in its Cloudflare Access overview.
CF_ACCESS_AUDIENCE=
# Exactly two Google email addresses, comma separated. Do not add other users.
AUTH_USER_EMAILS=

# --- Storage (paths as seen inside the container) ---
DATABASE_PATH=/data/estate.sqlite
DOCUMENTS_PATH=/data/documents

# --- Development only: never enable for a real installation ---
# This has no effect in production. In development it selects the isolated
# fictional database and document folder regardless of the storage paths above.
DEV_AUTH_ENABLED=false
# Optional demo-only document path:
# DEMO_DOCUMENTS_PATH=./data/demo-documents
