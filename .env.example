# Explicit fictional preview identity. Never enable for a real deployment.
DEV_AUTH_ENABLED=false
# When explicitly enabled in development, the app always uses ./data/demo.sqlite and ./data/demo-documents.
# Migrate it first: DATABASE_PATH=./data/demo.sqlite npm run db:migrate
# Production: your Cloudflare Access team issuer and application audience
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=
# Exactly two distinct Google email addresses; never client supplied
AUTH_USER_EMAILS=
DATABASE_PATH=./data/estate.sqlite
# Local document storage – in Unraid production this is /mnt/user/appdata/estate-organiser/documents mapped to /data/documents inside container
# Demo mode always uses ./data/demo-documents regardless of this setting
DOCUMENTS_PATH=./data/documents
